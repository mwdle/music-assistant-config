[Container]
Image=ghcr.io/music-assistant/server:2.10.13@sha256:7510aaa7ee5fc85b34fd0de17992bd14473895b23ce3eb9b310092743f4dbb84
ContainerName=music-assistant

Network=host

Timezone=local

Volume=%h/containers/music-assistant:/data:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8095/ || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

# Memory limit must be 4G+ to prevent random track skips
# https://github.com/music-assistant/support/issues/5849
Memory=4G
PidsLimit=256

[Service]
CPUQuota=200%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/music-assistant

[Install]
WantedBy=default.target
